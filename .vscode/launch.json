{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "1. Launch PhishGuard Backend (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/server.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "2. Launch React Frontend (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/client",
      "console": "integratedTerminal"
    },
    {
      "type": "python",
      "request": "launch",
      "name": "3. Launch Python ML Microservice (FastAPI)",
      "module": "uvicorn",
      "args": ["main:app", "--host", "127.0.0.1", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}/ml_service",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Launch All (Backend + Frontend)",
      "configurations": [
        "1. Launch PhishGuard Backend (Node.js)",
        "2. Launch React Frontend (Vite)"
      ]
    }
  ]
}
